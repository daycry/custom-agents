{
  "version": 1,
  "bindings": [
    {
      "id": "team-jira",
      "purpose": "task-tracking",
      "enabled": true,
      "contract_version": 1,
      "adapter": {
        "kind": "skill",
        "name": "jira-sync",
        "origin": "bundle"
      },
      "events": [
        "plan.created",
        "review.completed",
        "review.gaps",
        "review.worklog",
        "task.done",
        "task.implemented",
        "task.qa-failed",
        "task.qa-passed",
        "task.started"
      ],
      "capabilities": [
        "plan.export",
        "task.comment",
        "task.progress",
        "task.read",
        "worklog.write"
      ],
      "settings": ".claude/jira.json"
    },
    {
      "id": "team-confluence",
      "purpose": "documentation",
      "enabled": true,
      "contract_version": 1,
      "adapter": {
        "kind": "skill",
        "name": "confluence-publish",
        "origin": "bundle"
      },
      "events": [
        "phase.completed"
      ],
      "capabilities": [
        "docs.publish"
      ],
      "settings": ".claude/confluence.json"
    },
    {
      "id": "team-confluence-read",
      "purpose": "documentation",
      "enabled": true,
      "contract_version": 1,
      "adapter": {
        "kind": "skill",
        "name": "confluence-pull",
        "origin": "bundle"
      },
      "events": [],
      "capabilities": [
        "docs.pull"
      ],
      "settings": ".claude/confluence.json"
    }
  ]
}
