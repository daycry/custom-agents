# ⚠️ COPIA MANUAL: este fichero se copia TAL CUAL a .github/workflows/headless.yml
# (ruta protegida para las herramientas remotas). Estas líneas son comentarios
# YAML válidos: no hace falta borrar nada. `tests/test_ci_manual_copy.py` y
# `scripts/lint_plugin.py` avisan si las dos copias divergen.
#
# Job opcional con coste real: manual o lunes 06:00 UTC.
# La puerta recibe sólo la presencia booleana del secret. La clave real existe
# únicamente en los pasos evals/hooks. Instalar herramientas, lint y subir
# artefactos no heredan ANTHROPIC_API_KEY.
# Todo paso posterior lleva condición sobre steps.gate.outputs.skip y un id;
# la guardia final detecta pasos ejecutados cuando falta el secret.
name: Headless (evals + hooks reales)
on:
  workflow_dispatch:
  schedule:
    - cron: "0 6 * * 1"   # lunes 06:00 UTC

permissions:
  contents: read

jobs:
  headless:
    runs-on: ubuntu-latest
    timeout-minutes: 40
    outputs:
      skip: ${{ steps.gate.outputs.skip }}   # 'true' si no había secret (job saltado en verde)
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Puerta — ¿hay secret?
        id: gate
        env:
          HAS_ANTHROPIC_KEY: ${{ secrets.ANTHROPIC_API_KEY != '' }}
        run: |
          if [ "$HAS_ANTHROPIC_KEY" != "true" ]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            echo "::warning::ANTHROPIC_API_KEY no está configurado como secret del repo: se saltan los evals headless y la comprobación de hooks reales (job opcional; ver evals/README.md)."
          else
            echo "skip=false" >> "$GITHUB_OUTPUT"
          fi

      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        id: python
        if: steps.gate.outputs.skip == 'false'
        with:
          python-version: "3.11"

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        id: node
        if: steps.gate.outputs.skip == 'false'
        with:
          # 22 = LTS activa. NO 21: nunca fue LTS y está EOL desde junio de 2024; y la 20
          # llegó a EOL en abril de 2026. `engines` del paquete sigue en >= 18 (el
          # instalador solo usa API de 16.7+/17+), pero lo que se PRUEBA aquí es la 22.
          node-version: "22"

      - name: Instalar Claude Code
        id: install
        if: steps.gate.outputs.skip == 'false'
        run: |
          npm install -g @anthropic-ai/claude-code@2.1.311
          claude --version

      - name: Validación estática previa (barata; la misma de ci.yml)
        id: static
        if: steps.gate.outputs.skip == 'false'
        run: |
          python3 scripts/lint_plugin.py
          python3 evals/check.py

      - name: Evals de activación — subconjunto barato (claude -p --bare)
        id: evals
        if: steps.gate.outputs.skip == 'false'
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: |
          mkdir -p evals/reports
          python3 evals/run.py --bare --max-turns 4 --timeout 600 \
            --target skill:quick-implement --target command:setup \
            --report evals/reports/headless-evals.json

      - name: Hooks reales — PostToolUse progress-line.sh en una sesión headless con el plugin
        id: hooks
        if: steps.gate.outputs.skip == 'false'
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: |
          set -uo pipefail
          PLUGIN="$PWD"
          mkdir -p "$PLUGIN/evals/reports"
          PROMPT="Edita docs/roadmap/2026-01-01-demo/tasks.md marcando la tarea T-01 como completada: checkbox de sus criterios, estado completado y la fila del resumen de progreso. No hagas nada más."
          intento() {  # $1 = etiqueta (bare|full) · $2… = flags extra
            local tag="$1"; shift
            local WORK; WORK="$(mktemp -d)"
            cp -R "$PLUGIN/evals/fixtures/project/." "$WORK/"
            ( cd "$WORK" && git init -q && git add -A && git -c user.email=ci@example.com -c user.name=ci commit -q -m fixture )
            ( cd "$WORK" && claude -p "$@" --plugin-dir "$PLUGIN" --output-format stream-json --verbose \
                --permission-mode acceptEdits --max-turns 6 "$PROMPT" ) \
                > "$PLUGIN/evals/reports/headless-hooks-$tag.jsonl" 2> "$PLUGIN/evals/reports/headless-hooks-$tag.stderr" || true
            python3 - "$PLUGIN/evals/reports/headless-hooks-$tag.jsonl" "$WORK" "$tag" <<'PY'
          import json, os, sys
          stream, work, tag = sys.argv[1:4]
          init, result = None, None
          for ln in open(stream, encoding="utf-8", errors="replace"):
              try:
                  ev = json.loads(ln)
              except ValueError:
                  continue
              if ev.get("type") == "system" and ev.get("subtype") == "init":
                  init = ev
              if ev.get("type") == "result":
                  result = ev
          plugins = [p.get("name") for p in (init or {}).get("plugins", []) if isinstance(p, dict)]
          errores = (init or {}).get("plugin_errors", [])
          cargado = "custom-agents" in plugins
          testigo = os.path.join(work, ".claude", ".progress-last")
          hay_testigo = os.path.isfile(testigo) and os.path.getsize(testigo) > 0
          print(f"[{tag}] system/init: plugins={plugins} plugin_errors={errores}")
          print(f"[{tag}] result: subtype={(result or {}).get('subtype')} is_error={(result or {}).get('is_error')} turns={(result or {}).get('num_turns')} cost=${(result or {}).get('total_cost_usd')}")
          print(f"[{tag}] testigo del hook PostToolUse ({testigo}): {'PRESENTE → ' + open(testigo, encoding='utf-8').read().strip() if hay_testigo else 'AUSENTE'}")
          # 0 = evidencia completa · 10 = plugin cargó pero sin testigo (reintentar sin --bare) · 1 = el plugin no cargó
          sys.exit(0 if (cargado and hay_testigo) else (10 if cargado else 1))
          PY
          }
          intento bare --bare; rc=$?
          if [ "$rc" -eq 10 ]; then
            echo "::notice::Con --bare el plugin cargó pero el hook PostToolUse no dejó testigo (la doc no garantiza hooks de plugin en bare mode). Reintento SIN --bare."
            intento full; rc=$?
            [ "$rc" -eq 0 ] && echo "::warning::Evidencia de hooks obtenida SIN --bare: anótalo en docs/observability.md si se repite (bare mode no ejecuta los hooks del plugin)."
          fi
          if [ "$rc" -ne 0 ]; then
            echo "::error::Sin evidencia de que los hooks del plugin corran en una sesión real (rc=$rc). Revisa evals/reports/headless-hooks-*.jsonl en el artifact."
            exit 1
          fi
          echo "hooks en sesión real: OK"

      - name: Subir informes (evals + stream de la comprobación de hooks)
        id: upload
        if: always() && steps.gate.outputs.skip == 'false'
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: headless-reports
          path: |
            evals/reports/*.json
            evals/reports/*.jsonl
            evals/reports/*.stderr
          if-no-files-found: ignore
          retention-days: 30

      - name: Guardia del skip — sin secret, ningún paso posterior debe haber corrido
        if: always() && steps.gate.outputs.skip == 'true'
        env:
          OUTCOMES: >-
            python=${{ steps.python.outcome }}
            node=${{ steps.node.outcome }}
            install=${{ steps.install.outcome }}
            static=${{ steps.static.outcome }}
            evals=${{ steps.evals.outcome }}
            hooks=${{ steps.hooks.outcome }}
            upload=${{ steps.upload.outcome }}
        run: |
          echo "outcomes: $OUTCOMES"
          bad=0
          for kv in $OUTCOMES; do
            case "$kv" in *=skipped) ;; *) echo "::error::el paso '${kv%%=*}' corrió sin secret (outcome=${kv#*=}): le falta \`if: steps.gate.outputs.skip == 'false'\`"; bad=1;; esac
          done
          [ "$bad" -eq 0 ] && echo "skip limpio: todos los pasos posteriores quedaron 'skipped'"
          exit $bad
