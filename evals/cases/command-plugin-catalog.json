{
  "target": "command:plugin-catalog",
  "cases": [
    {
      "id": "catalog-extensions-literal",
      "prompt": "incluye extensiones de proyecto y usuario",
      "trigger": "literal",
      "expect": {
        "activates": true,
        "mentions": [
          "plugin-panel"
        ]
      }
    },
    {
      "id": "catalog-literal",
      "prompt": "Explora el catálogo del plugin en un control panel HTML local",
      "trigger": "literal",
      "expect": {
        "activates": true,
        "mentions": [
          "plugin-panel"
        ]
      }
    },
    {
      "id": "catalog-parafrasis",
      "prompt": "Quiero navegar por los agentes, skills y herramientas declaradas del plugin.",
      "trigger": "parafrasis",
      "expect": {
        "activates": true,
        "mentions": [
          "plugin-panel"
        ]
      }
    },
    {
      "id": "command-plugin-catalog-served",
      "prompt": "Abre un dashboard local con progreso actualizado desde el ledger.",
      "trigger": "parafrasis",
      "expect": {
        "activates": true,
        "mentions": [
          "--serve"
        ]
      }
    },
    {
      "id": "catalog-negativo",
      "prompt": "Genera un dashboard de estados y presupuestos de iniciativas.",
      "expect": {
        "activates": false,
        "redirect": "command:roadmap-status"
      }
    }
  ]
}
