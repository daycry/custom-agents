{
  "target": "skill:plugin-panel",
  "cases": [
    {
      "id": "plugin-panel-extensions-literal",
      "prompt": "incluye extensiones propias de proyecto y usuario",
      "trigger": "literal",
      "expect": {
        "activates": true,
        "mentions": [
          "project-pieces"
        ]
      }
    },
    {
      "id": "plugin-panel-literal",
      "prompt": "panel de capacidades",
      "trigger": "literal",
      "expect": {
        "activates": true,
        "mentions": [
          "plugin-panel"
        ]
      }
    },
    {
      "id": "plugin-panel-parafrasis",
      "prompt": "Quiero explorar las capacidades instaladas del bundle en un HTML local.",
      "trigger": "parafrasis",
      "expect": {
        "activates": true,
        "mentions": [
          "plugin-panel"
        ]
      }
    },
    {
      "id": "skill-plugin-panel-served",
      "prompt": "Quiero el panel con progreso actualizado del ledger local.",
      "trigger": "parafrasis",
      "expect": {
        "activates": true,
        "mentions": [
          "--serve"
        ]
      }
    },
    {
      "id": "plugin-panel-roadmap-literal",
      "prompt": "Enséñame el dashboard del roadmap con el kanban de los planes.",
      "trigger": "literal",
      "expect": {
        "activates": true,
        "mentions": [
          "plugin-panel"
        ]
      },
      "notes": "Absorbe «dashboard del roadmap»/«kanban de los planes» (D-A1)."
    },
    {
      "id": "plugin-panel-negativo",
      "prompt": "Calcula el resumen JSON de prioridad y presupuesto de las iniciativas del roadmap para priorizar el backlog.",
      "expect": {
        "activates": false,
        "redirect": "skill:roadmap-dashboard"
      }
    }
  ]
}
