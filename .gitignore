# === Salidas sensibles de los agentes (nunca versionar) ===
# Informes de auditoría de nemesis (contienen hallazgos y evidencias sensibles).
docs/security-scan/
**/security-scan/
# Excepción: fixtures de test bajo control de versión (contenido inventado,
# no un hallazgo real) que necesitan un docs/security-scan/ de mentira para
# probar la invariante de confluence-scope.py (gap I1, revisión adversarial).
!tests/fixtures/**

# === Binarios y dependencias de herramientas ===
# El toolkit de nemesis se instala fuera del repo (~/.claude/security-tools/).
# Por si algo cae dentro del árbol, no versionar binarios ni vendored tools.
**/bin/
**/vendor/
**/*.download
agent-kits/**/tools/bin/
agent-kits/**/tools/vendor/

# === Dependencias / entornos ===
node_modules/

# Manifiesto que deja `install/install.mjs` al instalar en un proyecto (dogfooding en este repo)
.custom-agents-install.json
.venv/
venv/
__pycache__/
*.pyc

# === Logs y temporales ===
*.log
*.tmp
tmp/
.cache/

# === Sistema operativo / sincronización ===
.DS_Store
Thumbs.db
desktop.ini
*~

# === Editores / IDE ===
.idea/
.vscode/
*.swp
*.swo

# === Estado LOCAL de las configs del plugin (no versionar) ===
# Marcadores del medidor y mapas de sincronización: son de la máquina/sesión,
# no del proyecto. `.claude/rates.json` SÍ se versiona (config económica del repo).
.claude/usage-state.json
.claude/jira-state.json
.claude/confluence-state.json
# Cola de outbox de la captura durable de SessionEnd (session-end-durable-capture, `journal.py
# capture-end`/`replay`): envelopes de sesión, nunca versionados; sobrevive a uninstall/upgrade del
# plugin (solo `journal.py purge --confirm` la borra). No confundir con docs/knowledge/journal/,
# que SÍ se versiona (memoria del proyecto).
.claude/journal/
# Debounce del hook de progreso (última línea emitida + cerrojo flock; live-visibility, debt-cleanup).
.claude/.progress-last
.claude/.progress-last.lock
.claude/.progress-last.*
# Marcas del hook de guardia del implementer (aviso único sin python3 / guardrails off).
.claude/.guardrail-nopython
.claude/.guardrail-off
# Caché del índice de piezas inyectado al arrancar (skill-index.py; se regenera por hash).
.claude/.skill-index.cache
.claude/.skill-index.cache.*
# Índice SQLite FTS5 de la memoria técnica (knowledge-find.py): CACHÉ reconstruible por hash del
# corpus, no el almacén — el almacén son los ficheros Markdown de docs/knowledge/ (memory-retrieval T-03).
# `**/`: también en proyectos anidados (el fixture de evals tiene su propio docs/knowledge/, T-09).
**/.claude/knowledge-index.sqlite
**/.claude/knowledge-index.sqlite.*
# Exportaciones de backends declarados en taxonomy.json (knowledge-services, ADR-018): SIEMPRE
# reconstruibles desde docs/knowledge/approved/ (fuente de verdad); nunca versionar el derivado.
# `**/`: también en proyectos anidados (p. ej. el fixture de evals con su propio `.claude/`).
**/.claude/knowledge-services/kwipu-export/
**/.claude/knowledge-services/*-export/

# Papelera local (device_bash no puede borrar): nunca versionar
_to_delete/

# Informes locales de evals/run.py (cuestan tokens; se citan en el ledger, no se versionan).
evals/reports/

# Paquete portable «solo skills» generado por scripts/export-skills.py (la Release lo adjunta como zip).
dist/

# === Estado LOCAL de sesión (lo escriben hooks o herramientas, nunca es del repo) ===
# Marca que deja hooks/mark-docs-pending.sh al editar docs/ (aviso para confluence-publish).
.claude/.confluence-pending
# Artefactos de herramientas externas dentro de .claude/ (MCP, envoltorios de contexto).
.claude/.headroom_wrap_marker.json
# Lo siembra el hook user-prompt-capture.sh en el proyecto consumidor; aqui el `*.log` de mas abajo
# ya cubre el log de turnos, y versionarlo cambiaria que regla gana en `git check-ignore`
# (lo comprueba tests/test_hooks_shell.py).
.claude/.gitignore
# Variante local del handoff: CONTINUE-HERE.md SÍ se versiona; la .local es tuya.
CONTINUE-HERE.local.md
# Bundles de git creados a mano para mover ramas entre máquinas.
*.bundle
