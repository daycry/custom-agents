# === Salidas sensibles de los agentes (nunca versionar) ===
# Informes de auditoría de nemesis (contienen hallazgos y evidencias sensibles).
docs/security-scan/
**/security-scan/
# Excepción: fixtures de test bajo control de versión (contenido inventado,
# no un hallazgo real) que necesitan un docs/security-scan/ de mentira para
# probar la invariante de confluence-scope.py (gap I1, revisión adversarial).
!tests/fixtures/**

# === Binarios y dependencias de herramientas ===
# El toolkit de nemesis se instala fuera del repo (~/.claude/security-tools/).
# Por si algo cae dentro del árbol, no versionar binarios ni vendored tools.
**/bin/
**/vendor/
**/*.download
agent-kits/**/tools/bin/
agent-kits/**/tools/vendor/

# === Dependencias / entornos ===
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# === Logs y temporales ===
*.log
*.tmp
tmp/
.cache/

# === Sistema operativo / sincronización ===
.DS_Store
Thumbs.db
desktop.ini
*~

# === Editores / IDE ===
.idea/
.vscode/
*.swp
*.swo

# === Estado LOCAL de las configs del plugin (no versionar) ===
# Marcadores del medidor y mapas de sincronización: son de la máquina/sesión,
# no del proyecto. `.claude/rates.json` SÍ se versiona (config económica del repo).
.claude/usage-state.json
.claude/jira-state.json
.claude/confluence-state.json
# Debounce del hook de progreso (última línea emitida + cerrojo flock; live-visibility, debt-cleanup).
.claude/.progress-last
.claude/.progress-last.lock
.claude/.progress-last.*
# Marcas del hook de guardia del implementer (aviso único sin python3 / guardrails off).
.claude/.guardrail-nopython
.claude/.guardrail-off
# Caché del índice de piezas inyectado al arrancar (skill-index.py; se regenera por hash).
.claude/.skill-index.cache
.claude/.skill-index.cache.*

# Papelera local (device_bash no puede borrar): nunca versionar
_to_delete/

# Informes locales de evals/run.py (cuestan tokens; se citan en el ledger, no se versionan).
evals/reports/

# Paquete portable «solo skills» generado por scripts/export-skills.py (la Release lo adjunta como zip).
dist/
