+def _parse_horas(campo):
+    """'est. 0,3h · real 1,2h (medido)' → (0.3, 1.2); 'real —' → None. Tolerante."""
+    def num(m):
+        if not m:
+            return None
+        try:
+            return float(m.group(1).replace(",", "."))
+        except ValueError:
+            return None
+    est = num(re.search(r"est\.?\s*([\d]+(?:[.,]\d+)?)\s*h", campo, re.I))
+    real = num(re.search(r"real\s*([\d]+(?:[.,]\d+)?)\s*h", campo, re.I))
+    return est, real
+
+
