diff --git a/agent-kits/shared/ledger-lint.py b/agent-kits/shared/ledger-lint.py
index a019c44..c2ef028 100755
--- a/agent-kits/shared/ledger-lint.py
+++ b/agent-kits/shared/ledger-lint.py
@@ -196,7 +196,8 @@ def lint(path):
 
     # ---- tabla de resumen (completadas/total por fase) ----
     resumen_rows = re.findall(
-        r"^\|\s*\*{0,2}\s*(Fase\s+\d+[^|*]*)\*{0,2}\s*\|\s*\*{0,2}(\d+)\*{0,2}\*?\s*\|\s*\*{0,2}(\d+)\*{0,2}\s*\|", text, re.M)
+        r"^\|\s*\*{0,2}\s*(Fase\s+(?:\d+|única|unica)\b[^|*]*)\*{0,2}\s*\|\s*\*{0,2}(\d+)\*{0,2}\*?\s*\|\s*\*{0,2}(\d+)\*{0,2}\s*\|",
+        text, re.M | re.I)
     if not resumen_rows:
         warnings.append("sin tabla «Resumen de progreso» reconocible (legacy)")
     else:
@@ -219,9 +220,10 @@ def lint(path):
 
 
 def norm_fase(s):
-    # captura sufijos ("Fase 3-bis") para que no colisionen con "Fase 3"
-    m = re.match(r"\s*Fase\s+(\d+(?:[.-]\w+)*)", s)
-    return f"fase-{m.group(1).lower()}" if m else s.strip().lower()
+    # captura sufijos ("Fase 3-bis") para que no colisionen con "Fase 3"; «Fase única» (vía
+    # rápida: una sola fase sin número) también es una clave válida
+    m = re.match(r"\s*Fase\s+(\d+(?:[.-]\w+)*|única|unica)\b", s, re.I)
+    return f"fase-{m.group(1).lower().replace('ú', 'u')}" if m else s.strip().lower()
 
 
 def main():
