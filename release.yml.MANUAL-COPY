# ⚠️ COPIA MANUAL: este fichero se copia TAL CUAL a .github/workflows/release.yml
# (ruta protegida para las herramientas remotas). Estas líneas son comentarios
# YAML válidos: no hace falta borrar nada.
#
# Al empujar un tag v* : empaqueta el plugin como zip, genera el paquete PORTABLE
# «solo skills» (scripts/export-skills.py --format all, validado con --check) como
# segundo zip, crea la GitHub Release y adjunta ambos zips como assets. El badge de
# descargas del README cuenta SOLO descargas de assets — sin esto marcaría 0 para siempre.
name: Release
on:
  push:
    tags: ["v*"]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Verificar manual PDF de la release
        run: python3 scripts/check-handbook.py

      - name: Empaquetar el plugin
        run: |
          VERSION="${GITHUB_REF_NAME#v}"
          mkdir -p /tmp/pkg /tmp/release-source
          git archive --format=tar HEAD | tar -xf - -C /tmp/release-source
          rsync -a --exclude '.git' --exclude '.github' --exclude 'docs/roadmap' \
                --exclude '*.MANUAL-COPY' /tmp/release-source/ "/tmp/pkg/custom-agents/"
          (cd /tmp/pkg && zip -qr "custom-agents-${VERSION}.zip" custom-agents)
          mv "/tmp/pkg/custom-agents-${VERSION}.zip" .
          ls -la custom-agents-*.zip

      - name: Paquete portable «solo skills» (AGENTS.md · Cursor · skills/)
        run: |
          VERSION="${GITHUB_REF_NAME#v}"
          python3 scripts/export-skills.py --out /tmp/portable --format all
          python3 scripts/export-skills.py --check /tmp/portable
          # zip reproducible: mtimes = fecha del commit del tag (SOURCE_DATE_EPOCH), sin extras
          # de sistema (-X), TZ fija; así el mismo tag produce el mismo zip byte a byte.
          export SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH:-$(git log -1 --pretty=%ct)}"
          find /tmp/portable -exec touch -d "@${SOURCE_DATE_EPOCH}" {} +
          (cd /tmp && TZ=UTC zip -X -qr "custom-agents-skills-portable-${VERSION}.zip" portable)
          mv "/tmp/custom-agents-skills-portable-${VERSION}.zip" .
          ls -la custom-agents-skills-portable-*.zip

      - name: Extraer las notas del CHANGELOG
        run: |
          VERSION="${GITHUB_REF_NAME#v}"
          awk -v ver="$VERSION" '
            $0 ~ "^## \\[" ver "\\]" {on=1; next}
            on && /^## \[/ {exit}
            on {print}
          ' CHANGELOG.md > /tmp/notes.md
          # fallback si la versión no está en el CHANGELOG
          [ -s /tmp/notes.md ] || echo "Ver [CHANGELOG.md](https://github.com/${GITHUB_REPOSITORY}/blob/master/CHANGELOG.md)" > /tmp/notes.md

      - name: Preparar assets verificados
        run: |
          mkdir -p release-assets
          cp custom-agents-[0-9]*.zip custom-agents-skills-portable-*.zip release-assets/
          cp output/pdf/custom-agents-manual-operativo.pdf output/pdf/custom-agents-manual-operativo.manifest.json release-assets/
          cp /tmp/notes.md release-assets/notes.md

      - name: Transferir assets al publicador
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: release-assets
          path: release-assets/
          retention-days: 1
          if-no-files-found: error

  publish:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Descargar assets del build
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: release-assets
          path: release-assets

      - name: Crear la release con los assets
        uses: softprops/action-gh-release@8a0cd651e5b2365bd640854a3fa5dfc70e4875f3 # v3.0.4
        with:
          body_path: release-assets/notes.md
          files: |
            release-assets/custom-agents-[0-9]*.zip
            release-assets/custom-agents-skills-portable-*.zip
            release-assets/custom-agents-manual-operativo.pdf
            release-assets/custom-agents-manual-operativo.manifest.json
          fail_on_unmatched_files: true
