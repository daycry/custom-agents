# ⚠️ COPIA MANUAL: este fichero se copia TAL CUAL a .github/workflows/ci.yml
# (ruta protegida para las herramientas remotas). Estas líneas son comentarios
# YAML válidos: no hace falta borrar nada.
name: CI
on:
  push:
    branches: [master]
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: "3.11"
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          # 22 = LTS activa. NO 21: nunca fue LTS y está EOL desde junio de 2024; y la 20
          # llegó a EOL en abril de 2026. `engines` del paquete sigue en >= 18 (el
          # instalador solo usa API de 16.7+/17+), pero lo que se PRUEBA aquí es la 22.
          node-version: "22"

      - name: Instalar pytest
        run: pip install pytest pyyaml pytest-xdist

      - name: Linter del plugin
        run: python scripts/lint_plugin.py

      - name: Manual PDF y fuentes coherentes
        run: python scripts/check-handbook.py

      - name: Evals — validación estática (cobertura y disparadores literales)
        # evals/run.py NO corre aquí (cuesta tokens); check.py garantiza que la suite exista y siga
        # atada a las descriptions reales
        run: python evals/check.py

      - name: Tests (suites del repo)
        # bucle, no lista fija: cualquier tests/test_*.py SIN `def test` (script, que pytest no
        # recoge) entra solo en la CI. Los que pytest ya recoge los corre el paso siguiente: antes se
        # ejecutaban dos veces (T-23, plugin-audit-2)
        run: |
          for t in $(grep -LE '^\s*(async )?def test' tests/test_*.py); do
            echo "── $t"
            python "$t" || exit 1
          done

      - name: Tests (pytest — tests/ + scripts shared + skills con suite propia + evals)
        # carpetas, no lista fija: cualquier test_*.py nuevo en tests/, en agent-kits/shared/, en
        # skills/*/scripts/ o en evals/ entra solo en la CI (review-lens-select vive junto a su skill)
        # `tests` va PRIMERO y es lo que arregla el hueco del intento 2: el bucle de arriba ejecuta
        # `python tests/test_X.py`, que en los ficheros SIN bloque `__main__` no ejecuta NADA, así
        # que 68 casos de tests/ (test_export_skills, test_release, test_roadmap_index) no corrían
        # en CI. Y al revés, las 8 suites de tests/ que son scripts (sin `def test_*`) pytest no las
        # recoge: las ejecuta `tests/test_suites_no_pytest.py`, para que la puerta local sea la de CI.
        # `-n auto` (pytest-xdist) reparte los tests entre los núcleos del runner y `--durations=20`
        # publica en el resumen los 20 más lentos (T-23, plugin-audit-2).
        run: python -m pytest tests agent-kits/shared agent-kits/knowledge-curator skills/adversarial-review/scripts skills/code-health/scripts skills/dependency-upgrade/scripts skills/changelog-sync/scripts skills/unit-tests/scripts skills/api-contract/scripts skills/jira-sync/scripts skills/knowledge-services/scripts skills/knowledge-category-template/scripts skills/training-data-services/scripts skills/confluence-publish/scripts evals -q -n auto -m "not serie" --durations=20

      - name: Tests (pytest — los marcados `serie`, sin xdist)
        # los de tiempo de pared (`< 1.5 s`) y orden de lecturas fallan bajo `-n auto` por la carga ajena;
        # llevan `@pytest.mark.serie` y corren aquí uno a uno (T-23, plugin-audit-2)
        run: python -m pytest tests agent-kits/shared agent-kits/knowledge-curator skills/adversarial-review/scripts skills/code-health/scripts skills/dependency-upgrade/scripts skills/changelog-sync/scripts skills/unit-tests/scripts skills/api-contract/scripts skills/jira-sync/scripts skills/knowledge-services/scripts skills/knowledge-category-template/scripts skills/training-data-services/scripts skills/confluence-publish/scripts evals -q -m serie

      - name: "Bench captura de SessionEnd (CA-02: p95 ≤ 100 ms / p99 ≤ 300 ms)"
        # session-end-durable-capture: mide journal.py capture-end end-to-end (30 iteraciones, el
        # mismo camino que corre hooks/session-journal.sh en el teardown); exit 1 si un percentil
        # supera el umbral — la CI es el "CI de referencia" que cita la spec (CA-02).
        run: python scripts/bench-session-end.py --iterations 30 --assert-p95-ms 100 --assert-p99-ms 300

      - name: Interop Codex/OpenCode — ¿los ficheros generados reflejan las piezas?
        # Misma puerta que corre release.py: si alguien toca un agente/comando/hook y no regenera,
        # el plugin dejaría de importarse bien en Codex u OpenCode (docs/INTEROP.md §5)
        run: python scripts/export-interop.py --check

      - name: Suites de Node (instalador npx + adaptador de hooks de OpenCode)
        # La shell expande el glob: cada tests/*.test.mjs entra automáticamente.
        # Dos archivos simultáneos conservan todos los casos y sus plazos nativos;
        # evitan saturar los procesos de arranque y limpieza de las fixtures.
        run: node --test --test-concurrency=2 tests/*.test.mjs

      - name: Sintaxis de todos los scripts Python
        run: |
          python - <<'PY'
          import ast, pathlib, sys
          bad = []
          for p in pathlib.Path('.').rglob('*.py'):
              if '.git' in p.parts: continue
              try: ast.parse(p.read_text(encoding='utf-8'))
              except SyntaxError as e: bad.append(f"{p}: {e}")
          if bad: sys.exit("\n".join(bad))
          print("sintaxis OK")
          PY

      - name: JSONs válidos + versiones coherentes
        run: |
          python - <<'PY'
          import json, pathlib, sys
          for p in pathlib.Path('.').rglob('*.json'):
              if '.git' in p.parts: continue
              try: json.load(open(p, encoding='utf-8'))
              except Exception as e: sys.exit(f"JSON inválido {p}: {e}")
          print("JSONs OK")
          PY
          python scripts/release.py --check
